<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_default_background"
    android:orientation="vertical">

    <TextView
        android:id="@+id/textViewMunicipalityName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/municipality_tianjin"
        android:gravity="center"
        android:padding="24dp"
        android:text="Municipality"
        android:textColor="@color/color_text_light"
        android:textSize="28sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/imageViewMunicipality"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:contentDescription="Municipality image"
        android:scaleType="centerCrop"
        android:src="@drawable/beijing" />

    <ScrollView
        android:id="@+id/scrollViewInformation"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <TextView
            android:id="@+id/textViewInformation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.2"
            android:padding="24dp"
            android:text="Municipality information"
            android:textColor="@color/color_text_dark"
            android:textSize="18sp" />

    </ScrollView>

    <Button
        android:id="@+id/buttonVisitSite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:backgroundTint="@color/municipality_tianjin"
        android:minHeight="56dp"
        android:text="Visit site"
        android:textColor="@color/color_text_light"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>